# Copie para .env (o `npm run setup` faz isso sozinho) e ajuste se precisar.
# Nunca coloque segredos reais no .env.example: ele vai para o git.

# development | test | production
NODE_ENV=development

# Porta da API
PORT=3001

# Banco SQLite (caminho relativo à pasta server/) — desenvolvimento e instalações pequenas
DB_PATH=./data/app.db

# Postgres (recomendado em produção): preenchido, a plataforma fica no schema public e cada espaço no schema
# espaco_<id>; DB_PATH e ESPACOS_DIR deixam de ser usados. Para levar os dados do SQLite: npm run db:para-postgres
# DATABASE_URL=postgres://usuario:senha@localhost:5432/financas
# Bancos dos espaços (um por espaço: pessoal, holding, empresa...)
ESPACOS_DIR=./data/espacos

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------- Acesso
# Endereço do front, usado nos links de redefinição de senha
APP_URL=http://localhost:5173

# Sessão expira após X horas sem uso; "lembrar de mim" dura X dias
SESSION_HOURS=12
REMEMBER_DAYS=30

# Sistema servido em HTTPS: cookie seguro + HSTS + upgrade de requisições.
# Padrão: true em produção, false nos demais. Para testar o build localmente
# sem HTTPS (npm start), use COOKIE_SECURE=false.
# COOKIE_SECURE=true

# Administradores precisam configurar a verificação em duas etapas (aplicativo autenticador) para entrar.
# Padrão: true em produção, false nos demais.
# ADMIN_2FA_OBRIGATORIO=true

# Quantos proxies/load balancers ficam na frente do servidor (0 = nenhum)
TRUST_PROXY=0

# ---------------------------------------------------------------- E-mail
# Sem SMTP_HOST os e-mails (ex.: redefinição de senha) aparecem no log do terminal.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Sistema <nao-responda@localhost>

# ---------------------------------------------------------------- Arquivos
# Pasta dos anexos (relativa a server/) e tamanho máximo de anexo/importação em MB.
# O backup pela tela copia só o banco: copie esta pasta junto.
# UPLOAD_DIR=./data/anexos
# UPLOAD_MAX_MB=10

# ---------------------------------------------------------------- Demonstração
# Cadastros de exemplo (Clientes, Categorias, Movimentos) com todos os recursos
# do frame: máscaras, filtros, período, totais, lixeira, exportação...
# Ligue em desenvolvimento para ver e testar o motor. Não use em produção.
# DEMO=true

# ---------------------------------------------------------------- Radar
# Pipedrive: token da API (Pipedrive → Configurações pessoais → API). Usado na sincronização de
# contas-alvo e pessoas-chave (0.2.0). PIPEDRIVE_DOMINIO = o que vem antes de .pipedrive.com no endereço.
# PIPEDRIVE_API_TOKEN=
# PIPEDRIVE_DOMINIO=lighthouse
# Apify: token da API (console.apify.com → Settings → API & Integrations). Usado na coleta (0.3.0).
# APIFY_TOKEN=
