# Bug do npm: ao instalar a partir do package-lock ele ignora o "gypfile": false do
# better-sqlite3 e tenta compilá-lo com node-gyp (falha em Node novo). Nenhuma
# dependência deste projeto precisa de script de instalação: o better-sqlite3 já
# traz o binário pronto para Mac/Linux/Windows. Se um dia entrar um pacote que
# precise, rode `npm rebuild <pacote>` depois do install.
ignore-scripts=true
engine-strict=true
