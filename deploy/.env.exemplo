# Copie para deploy/.env e preencha. Este arquivo NUNCA vai para o git (segredos).

# Endereço do sistema. Sem domínio ainda: <ip-com-hífens>.sslip.io (HTTPS funciona igual)
DOMINIO=3-129-231-124.sslip.io
APP_URL=https://3-129-231-124.sslip.io

# Postgres (só a aplicação acessa; não fica exposto na internet). Senha: openssl rand -hex 24
POSTGRES_DB=financas
POSTGRES_USER=financas
POSTGRES_PASSWORD=

# E-mail. Gmail: senha de app (Conta Google → Segurança → Senhas de app); o remetente é o próprio Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu.email@gmail.com
SMTP_PASS=
SMTP_FROM=Finanças <seu.email@gmail.com>

# Administradores precisam de verificação em duas etapas (padrão em produção)
ADMIN_2FA_OBRIGATORIO=true

# Backup: hora, quantos dias guardar e (opcional) bucket S3 para cópia fora do servidor
BACKUP_HORA=03:30
BACKUP_DIAS=14
# BACKUP_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-2
